# Node.js dependencies (do not commit these!)
node_modules/

# Environment variables (contains API keys - NEVER commit!)
.env

# Package lock files (optional - some prefer to commit these)
package-lock.json

# OS-specific files
.DS_Store
Thumbs.db

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo

# Log files
*.log
npm-debug.log*

# Temporary files
*.tmp
*.temp

# Quiz question content — kept private so students can't see questions on GitHub
# Paste quiz-content.js as a second file in the Apps Script project
**/quiz-content.js

# Printable exam copies with answer keys — for emailing to admin only
Unit_04_Programming_Electronics_and_Sensors/Final_Exam_Print/

# Raw personal travel documents (booking confirmations, tickets, etc.) —
# these contain PINs, card digits, unique QR/barcodes, or other sensitive
# data. Only the redacted + password-protected copies in Travel/documents/
# are meant to be committed. Drop raw uploads directly in Travel/, not
# in a subfolder, so this catches them.
Travel/*.pdf

# PLTW source materials — most files kept locally, not published to the repo.
# The 6 Unit 0 HTML files linked by lessons ARE published; their _files asset
# folders are un-ignored so the pages render correctly on GitHub Pages.
PLTW Unit 0 Resources/*
!PLTW Unit 0 Resources/Design Process.html
!PLTW Unit 0 Resources/Design Process_files
!PLTW Unit 0 Resources/Writing a Design Brief.html
!PLTW Unit 0 Resources/Writing a Design Brief_files
!PLTW Unit 0 Resources/Active Listening and Interpreting.html
!PLTW Unit 0 Resources/Active Listening and Interpreting_files
!PLTW Unit 0 Resources/Brainstorming Solutions.html
!PLTW Unit 0 Resources/Brainstorming Solutions_files
!PLTW Unit 0 Resources/Concept Sketching.html
!PLTW Unit 0 Resources/Concept Sketching_files
!PLTW Unit 0 Resources/Decision Matrix.html
!PLTW Unit 0 Resources/Decision Matrix_files
PLTW Unit 1 Resources/
PLTW Unit 2 Resources/
PLTW Unit 3 Resources/
PLTW Unit 4 Resources/

# Archived Arduino lesson content — kept locally for reference, not published
Unit_04_Programming_Electronics_and_Sensors/Archive/

# Archived RP&M unit folder — content merged into Unit 2 CAD for HS AER
