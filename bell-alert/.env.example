# Tuya IoT Platform credentials
# Copy this file to .env and fill in your values — never commit .env to git

# From your Tuya IoT project (iot.tuya.com → Cloud → your project → Overview)
TUYA_ACCESS_ID=your_access_id_here
TUYA_ACCESS_SECRET=your_access_secret_here

# API region: us | eu | cn | in  (pick the one matching your account region)
TUYA_REGION=us

# Device IDs for your two smart plugs
# Get these from: iot.tuya.com → Cloud → your project → Devices
# Or run:  python override.py --scan
DEVICE_ID_1=your_plug_1_device_id
DEVICE_ID_2=your_plug_2_device_id
